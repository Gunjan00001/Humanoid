#!/bin/bash
#PBS -N bakeoff_naming
#PBS -q gpu
#PBS -l select=1:ncpus=4:mem=60gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o bakeoff_logs.log
#PBS -e /home/user/Desktop/Humanoid/logs/bakeoff_naming_job.err
# Naming bake-off on the labelled crop set. One large model per GPU: the job
# pins the A100 with the most free memory, runs the smallest challenger first
# (Qwen3.5-4B), and retries on the next one if the first attempt OOMs.

cd "$HOME/Desktop/Humanoid" || exit 1
export PY=/home/user/miniconda3/envs/spatialdiff/bin/python
export HF_HUB_OFFLINE=1            # compute nodes have no internet
export TRANSFORMERS_OFFLINE=1

idlest() {  # print the CUDA index of the GPU with the most free memory
  nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits \
    | sort -t, -k2 -rn | head -1 | cut -d, -f1
}

for ATTEMPT in 1 2 3; do
  GPU=$(idlest)
  echo "=== attempt $ATTEMPT on GPU $GPU ($(date +%T)) ==="
  CUDA_VISIBLE_DEVICES=$GPU timeout 3000 $PY scripts/bakeoff_naming.py \
      --model "$HOME/models/Qwen3.5-4B" --device cuda:0 \
      --out logs/bakeoff_naming_Qwen3.5-4B.json
  code=$?
  if [ $code -eq 0 ]; then
    echo "BAKEOFF_DONE"
    exit 0
  fi
  echo "attempt $ATTEMPT failed (code $code); re-pinning"
done
echo "BAKEOFF_FAILED"
exit 1
