#!/bin/bash
# Naming bake-off over the labelled crop set, one model per GPU.
# Submit with qsub -v KEY=VALUE ...:
#   MODEL=4B|9B|27B (implies MODEL_DIR=$HOME/models/Qwen3.5-$MODEL, TAG=Qwen3.5-$MODEL)
#   MODEL_DIR=... TAG=... DEVICE=cuda:0|auto MAXMEM=40GiB
#   PROTOCOL=free|loglik  CANDIDATES=all|top10
# Paths: PBS directives are relative to the submission directory (variables are
# not expanded there); the body uses $PBS_O_WORKDIR and $HOME only.
#PBS -N bakeoff_naming
#PBS -q gpu
#PBS -l select=1:ncpus=4:mem=60gb:ngpus=1
#PBS -l walltime=04:00:00
#PBS -o logs/bakeoff_naming_job.log
#PBS -e logs/bakeoff_naming_job.err

cd "$PBS_O_WORKDIR" || exit 1
MODEL="${MODEL:-4B}"
MODEL_DIR="${MODEL_DIR:-$HOME/models/Qwen3.5-$MODEL}"
TAG="${TAG:-Qwen3.5-$MODEL}"
DEVICE="${DEVICE:-cuda:0}"
PROTOCOL="${PROTOCOL:-free}"
CANDIDATES="${CANDIDATES:-all}"
PY="${SPATIALDIFF_PYTHON:-$HOME/miniconda3/envs/spatialdiff/bin/python}"
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

idlest() {
  nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits \
    | sort -t, -k2 -rn | head -1 | cut -d, -f1
}

EXTRA="--protocol $PROTOCOL --candidates $CANDIDATES"
[ -n "$MAXMEM" ] && EXTRA="$EXTRA --max-memory $MAXMEM"

for ATTEMPT in 1 2 3; do
  GPU=$(idlest)
  echo "=== $TAG attempt $ATTEMPT on GPU $GPU ($(date +%T)) protocol=$PROTOCOL/$CANDIDATES ==="
  if [ "$DEVICE" = "auto" ]; then PINNED="$DEVICE"; else PINNED="cuda:0"; fi
  CUDA_VISIBLE_DEVICES=$GPU timeout 13000 "$PY" scripts/bakeoff_naming.py \
      --model "$MODEL_DIR" --device "$PINNED" $EXTRA \
      --out "logs/bakeoff_naming_${TAG}_${PROTOCOL}_${CANDIDATES}.json"
  code=$?
  [ $code -eq 0 ] && { echo "BAKEOFF_DONE"; exit 0; }
  echo "attempt $ATTEMPT failed (code $code); re-pinning"
done
echo "BAKEOFF_FAILED"
exit 1
