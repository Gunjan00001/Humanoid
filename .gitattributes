# Git LFS: large binaries (see rules.md §5.2)
*.mp4        filter=lfs diff=lfs merge=lfs -text
*.mov        filter=lfs diff=lfs merge=lfs -text
*.avi        filter=lfs diff=lfs merge=lfs -text
*.ply        filter=lfs diff=lfs merge=lfs -text
*.pt         filter=lfs diff=lfs merge=lfs -text
*.pth        filter=lfs diff=lfs merge=lfs -text
*.ckpt       filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.onnx       filter=lfs diff=lfs merge=lfs -text

# --- small demo videos (< 5 MB each): plain git, no LFS ----------------
# (later lines override earlier ones; keep these AFTER the *.mp4 rule)
data/a.mp4         -filter -diff -merge -text
data/b.mp4         -filter -diff -merge -text
data/scene2/a.mp4  -filter -diff -merge -text
data/scene2/b.mp4  -filter -diff -merge -text
data/scene3/a.mp4  -filter -diff -merge -text
data/scene3/b.mp4  -filter -diff -merge -text
# scene5/b.mp4 is a re-encode (4.6 MB, same 480x860@30fps) of the original
# 6.9 MB LFS recording (oid 1be79cea00); the original stays in the LFS history
data/scene5/b.mp4  -filter -diff -merge -text
data/scene5/a.mp4  -filter -diff -merge -text
# scene6: re-encodes (3.3 MB + 2.7 MB, same 860x480@30fps) of the original
# LFS recordings (a oid baf3f76f34, b oid cf1d265b48); the originals are
# preserved in LFS under data/scene6/original/ (and the data-v0.5 history)
data/scene6/a.mp4  -filter -diff -merge -text
data/scene6/b.mp4  -filter -diff -merge -text

# --- language statistics ------------------------------------------------
# The viewers are generated: one HTML page with a big embedded JSON blob per
# scene, 1.8 to 5.5 MB each and about 20 MB in total. Left alone they make HTML
# the top language on GitHub, which hides the actual source. They are build
# output, not source, so linguist should ignore them.
outputs/viewer.html              linguist-generated=true
outputs/**/viewer.html           linguist-generated=true
# Keep them as plain git, never LFS: GitHub Pages serves LFS files as pointers,
# so an LFS viewer would show a text stub instead of the interactive page.
outputs/viewer.html              -filter -diff -merge -text
outputs/**/viewer.html           -filter -diff -merge -text
# The same applies to the rendered animations and figures next to the viewers.
outputs/**/change.gif            linguist-generated=true
docs/figures/*.png               linguist-generated=true

# --- prose and vendored code -------------------------------------------
# Docs are prose, not a programming language.
*.md                             linguist-documentation
docs/**                          linguist-documentation
# third_party holds the upstream SceneDiff evaluator and vendored tools.
third_party/**                   linguist-vendored
# notebooks and configs stay visible: configs/default.yaml is the single source
# of every threshold in the pipeline, so it should count.
