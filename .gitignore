# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- caches / large artifacts ---
cache/
logs/
outputs/*
!outputs/report.json
!outputs/report.md
!outputs/change.gif
!outputs/changes/
!outputs/changes/*.png
!outputs/viewer.html
# per-scene results (scene2, scene3, ...) - keep the deliverables, not the PLY
!outputs/scene*/
!outputs/scene*/report.json
!outputs/scene*/report.md
!outputs/scene*/change.gif
!outputs/scene*/changes/
!outputs/scene*/changes/*.png
!outputs/scene*/viewer.html
models/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.ply

# --- scene deliverables that ARE PLY but small (part of the gallery) ---
# (these exceptions must come after *.ply - the last matching pattern wins)
!outputs/scene_mesh.ply
!outputs/scene*/scene_mesh.ply

# --- data: keep small samples, ignore large recordings ---
data/*.mp4
data/*.mov
!data/sample_*.mp4

# --- editors / OS ---
.vscode/
.idea/
.DS_Store
third_party/

# --- agent / graph tooling (local only, not part of the deliverable) ---
.opencode/
graphify-out/
.commandcode/
data/external/
data/scenediff_benchmark
outputs/scenediff/
cache/scenediff/

# Interpreter used by scripts/sprint.py and scripts/finish_c*.sh
SPATIALDIFF_PYTHON=
